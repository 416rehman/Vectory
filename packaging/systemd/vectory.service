[Unit]
Description=Vectory outbound configuration agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vectory
Group=vectory
ExecStart=/usr/bin/vectory run --state-dir /var/lib/vectory-agent
Restart=on-failure
RestartSec=5s
# 78: not installed or not enrolled yet. Run `sudo vectory setup` first.
RestartPreventExitStatus=78
# Stop signals only the agent; it asks Vector for one graceful drain and waits.
# Processes still left at the timeout are killed. (control-group would signal
# Vector directly as well, and Vector treats a second signal as "quit now".)
KillMode=mixed
# Longer than Vector's longest graceful drain (--graceful-shutdown-seconds, at most 300).
TimeoutStopSec=330s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=-/var/lib/vectory-agent -/etc/vectory/managed
UMask=0077

[Install]
WantedBy=multi-user.target
