[Unit]
Description=Vectory outbound configuration agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vectory
Group=vectory
ExecStart=/usr/bin/vectory run --state-dir /var/lib/vectory-agent
Restart=on-failure
RestartSec=5s
# 78: not installed or not enrolled yet. Run `sudo vectory setup` first.
RestartPreventExitStatus=78
KillMode=control-group
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=-/var/lib/vectory-agent -/etc/vectory/managed
UMask=0077

[Install]
WantedBy=multi-user.target
