{
  "sources": {
    "sample": {
      "type": "opentelemetry",
      "grpc": {
        "address": "127.0.0.1:4317"
      },
      "http": {
        "address": "127.0.0.1:4318"
      }
    }
  },
  "transforms": {
    "enrich": {
      "type": "remap",
      "inputs": [
        "sample.logs"
      ],
      "source": ".environment = \"development\"\n.managed_by = \"vectory\""
    }
  },
  "sinks": {
    "output": {
      "type": "console",
      "inputs": [
        "enrich"
      ],
      "encoding": {
        "codec": "json"
      },
      "target": "stderr"
    }
  }
}
