{
  "sources": {
    "demo": {
      "type": "demo_logs",
      "format": "json",
      "interval": 1
    }
  },
  "transforms": {
    "enrich": {
      "type": "remap",
      "inputs": [
        "demo"
      ],
      "source": ".environment = \"development\"\n.managed_by = \"vectory\""
    }
  },
  "sinks": {
    "output": {
      "type": "loki",
      "inputs": [
        "enrich"
      ],
      "endpoint": "https://loki.example.com",
      "encoding": {
        "codec": "json"
      },
      "labels": {
        "service": "vectory"
      }
    }
  }
}
