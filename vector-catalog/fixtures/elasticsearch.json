{
  "sources": {
    "demo": {
      "type": "demo_logs",
      "format": "json",
      "interval": 1
    }
  },
  "transforms": {
    "enrich": {
      "type": "remap",
      "inputs": [
        "demo"
      ],
      "source": ".environment = \"development\"\n.managed_by = \"vectory\""
    }
  },
  "sinks": {
    "output": {
      "type": "elasticsearch",
      "inputs": [
        "enrich"
      ],
      "endpoints": [
        "https://elasticsearch.example.com:9200"
      ],
      "mode": "bulk"
    }
  }
}
