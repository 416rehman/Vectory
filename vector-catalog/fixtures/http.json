{
  "sources": {
    "demo": {
      "type": "demo_logs",
      "format": "json",
      "interval": 1
    }
  },
  "transforms": {
    "enrich": {
      "type": "remap",
      "inputs": [
        "demo"
      ],
      "source": ".environment = \"development\"\n.managed_by = \"vectory\""
    }
  },
  "sinks": {
    "output": {
      "type": "http",
      "uri": "https://logs.example.com",
      "encoding": {
        "codec": "json"
      },
      "inputs": [
        "enrich"
      ]
    }
  }
}
