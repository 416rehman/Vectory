      "findings": [{"code": "plaintext_credential", "path": "sinks.out.request.headers.X-Auth-Token"}]
    },
    {
      "name": "native secret in header remains valid",
      "config": {"sinks": {"out": {"type": "http", "request": {"headers": {"Authorization": "Bearer SECRET[team.key]"}}}}},
      "findings": []
    },
    {
      "name": "native environment reference in header remains valid",
      "config": {"sinks": {"out": {"type": "http", "request": {"headers": {"Authorization": "$TOKEN"}}}}},
