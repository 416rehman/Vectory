    {
      "name": "mixed native and plaintext cookies are refused",
      "config": {"sinks": {"out": {"type": "http", "request": {"headers": {"Cookie": "sid=synthetic-value; theme=${THEME}"}}}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.request.headers.Cookie"}]
    },
    {
      "name": "all plaintext findings are reported",
      "config": {"sinks": {"out": {"type": "http", "request": {"headers": {"X-Team-Key": "synthetic-one-value", "Authorization": "synthetic-two-value"}}}}},
      "findings": [
        {"code": "plaintext_credential", "path": "sinks.out.request.headers.Authorization"},
        {"code": "plaintext_credential", "path": "sinks.out.request.headers.X-Team-Key"}
