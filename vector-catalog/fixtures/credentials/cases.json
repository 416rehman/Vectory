{
  "about": "Synthetic plaintext-credential detector cases shared by Rust and TypeScript. Values are invented test strings, never usable credentials.",
  "cases": [
    {
      "name": "typed credential field",
      "config": {"sinks": {"out": {"type": "datadog_logs", "default_api_key": "synthetic-key-value"}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.default_api_key"}]
    },
    {
      "name": "typed credential field is strict even for short values",
      "config": {"sinks": {"out": {"type": "datadog_logs", "default_api_key": "x"}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.default_api_key"}]
    },
    {
      "name": "legacy sink auth user",
      "config": {"sinks": {"out": {"type": "http", "auth": {"user": "synthetic-user"}}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.auth.user"}]
    },
    {
      "name": "legacy sink auth cannot hide a short value in an array",
      "config": {"sinks": {"out": {"type": "http", "auth": {"user": ["short"]}}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.auth.user[0]"}]
    },
    {
      "name": "normalized credential key",
      "config": {"sinks": {"out": {"type": "http", "api-key": "synthetic-key-value"}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.api-key"}]
    },
    {
      "name": "credential suffix",
      "config": {"sinks": {"out": {"type": "http", "service_token": "synthetic-token-value"}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.service_token"}]
    },
    {
      "name": "credential key cannot hide a short value in an array",
      "config": {"sinks": {"out": {"type": "http", "api_key": ["short"]}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.api_key[0]"}]
    },
    {
      "name": "credential key cannot hide a short value in an object",
      "config": {"sinks": {"out": {"type": "http", "api_key": {"value": "short"}}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.api_key.value"}]
    },
    {
      "name": "unknown top-level object cannot hide a credential",
      "config": {"custom": {"api_key": {"value": "short"}}},
      "findings": [{"code": "plaintext_credential", "path": "custom.api_key.value"}]
    },
    {
      "name": "native credential list name with malformed scalar",
      "config": {"sources": {"in": {"type": "http_server", "valid_tokens": "short"}}},
      "findings": [{"code": "plaintext_credential", "path": "sources.in.valid_tokens"}]
    },
    {
      "name": "native credential list name with malformed nested value",
      "config": {"sources": {"in": {"type": "http_server", "access_keys": {"value": "short"}}}},
      "findings": [{"code": "plaintext_credential", "path": "sources.in.access_keys.value"}]
    },
    {
      "name": "hyphenated native credential list name retains its meaning",
      "config": {"sources": {"in": {"type": "http_server", "valid-tokens": ["short"]}}},
      "findings": [{"code": "plaintext_credential", "path": "sources.in.valid-tokens[0]"}]
    },
    {
      "name": "dotted native credential list name retains its meaning",
      "config": {"sources": {"in": {"type": "http_server", "access.keys": {"value": "short"}}}},
      "findings": [{"code": "plaintext_credential", "path": "sources.in.access.keys.value"}]
    },
    {
      "name": "short named credential still cannot enter history",
      "config": {"sinks": {"out": {"type": "http", "service_token": "tiny"}}},
      "findings": [{"code": "plaintext_credential", "path": "sinks.out.service_token"}]
    },
    {
      "name": "documented placeholder is not a credential finding",
      "config": {"sinks": {"out": {"type": "http", "service_token": "changeme"}}},
      "findings": []
    },
