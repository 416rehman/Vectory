{
  "description": "A TLS file is a file under an allowed root; the root it needs is the file itself.",
  "vector": "valid",
  "config": {
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "sinks": {
      "out": {
        "type": "http",
        "inputs": [
          "in"
        ],
        "uri": "https://collector.example.net/ingest",
        "encoding": {
          "codec": "json"
        },
        "tls": {
          "ca_file": "/etc/ssl/collector/ca.pem"
        }
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [],
    "components": [],
    "capabilities": [],
    "network": [
      "collector.example.net:443"
    ],
    "listeners": [],
    "file_roots": [
      "/etc/ssl/collector/ca.pem"
    ],
    "writes": [],
    "assets": []
  }
}
