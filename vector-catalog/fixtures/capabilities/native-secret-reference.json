{
  "description": "A native secret reference needs a secret backend, and both need full mode.",
  "vector": "skip",
  "vector_error": "Vector resolves native secrets from their backend while it loads the configuration, before any validation.",
  "config": {
    "secret": {
      "vault": {
        "type": "file",
        "path": "/etc/vector/secrets.json"
      }
    },
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "sinks": {
      "out": {
        "type": "http",
        "inputs": [
          "in"
        ],
        "uri": "https://collector.example.net/",
        "encoding": {
          "codec": "json"
        },
        "request": {
          "headers": {
            "Authorization": "SECRET[vault.token]"
          }
        }
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [
      {
        "code": "UNSUPPORTED_LOCAL_CAPABILITY",
        "at": "/secret"
      },
      {
        "code": "DYNAMIC_CAPABILITY_DENIED",
        "at": "/sinks/out/request/headers/Authorization"
      }
    ],
    "components": [],
    "capabilities": [],
    "network": [
      "collector.example.net:443"
    ],
    "listeners": [],
    "file_roots": [],
    "writes": [],
    "assets": []
  }
}
