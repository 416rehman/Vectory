{
  "description": "A path inside base_dir needs base_dir alone.",
  "vector": "valid",
  "config": {
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "sinks": {
      "out": {
        "type": "file",
        "inputs": [
          "in"
        ],
        "encoding": {
          "codec": "json"
        },
        "base_dir": "/srv/vector/out",
        "path": "/srv/vector/out/{{ host }}/app.log"
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [],
    "components": [],
    "capabilities": [],
    "network": [],
    "listeners": [],
    "file_roots": [
      "/srv/vector/out"
    ],
    "writes": [
      "/srv/vector/out"
    ],
    "assets": []
  }
}
