{
  "description": "An AWS credentials file can name a program Vector runs (credential_process), so it needs full mode wherever it lies.",
  "vector": "valid",
  "config": {
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "sinks": {
      "out": {
        "type": "aws_s3",
        "inputs": [
          "in"
        ],
        "bucket": "logs",
        "region": "us-east-1",
        "encoding": {
          "codec": "json"
        },
        "auth": {
          "credentials_file": "/srv/aws/credentials",
          "profile": "vector"
        }
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [
      {
        "code": "UNSUPPORTED_LOCAL_CAPABILITY",
        "at": "/sinks/out/auth/credentials_file"
      }
    ],
    "components": [
      "aws_s3"
    ],
    "capabilities": [
      "instance-credentials"
    ],
    "network": [],
    "listeners": [],
    "file_roots": [],
    "writes": [],
    "assets": []
  }
}
