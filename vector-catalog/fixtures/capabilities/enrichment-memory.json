{
  "description": "A memory table keeps its entries in memory and needs nothing from the host.",
  "vector": "valid",
  "config": {
    "enrichment_tables": {
      "seen": {
        "type": "memory",
        "ttl": 600,
        "inputs": [
          "kv"
        ]
      }
    },
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "transforms": {
      "kv": {
        "type": "remap",
        "inputs": [
          "in"
        ],
        "source": ". = {\"key\": to_string!(.host), \"value\": \"1\"}"
      }
    },
    "sinks": {
      "out": {
        "type": "blackhole",
        "inputs": [
          "in"
        ]
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [],
    "components": [],
    "capabilities": [],
    "network": [],
    "listeners": [],
    "file_roots": [],
    "writes": [],
    "assets": []
  }
}
