{
  "description": "Secret backends can run programs and read files, so they need full mode.",
  "vector": "valid",
  "config": {
    "secret": {
      "vault": {
        "type": "exec",
        "command": [
          "/usr/local/bin/fetch-secret"
        ]
      }
    },
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "sinks": {
      "out": {
        "type": "blackhole",
        "inputs": [
          "in"
        ]
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [
      {
        "code": "UNSUPPORTED_LOCAL_CAPABILITY",
        "at": "/secret"
      }
    ],
    "components": [],
    "capabilities": [],
    "network": [],
    "listeners": [],
    "file_roots": [],
    "writes": [],
    "assets": []
  }
}
