{
  "description": "A remap that loads its program from a file on the device needs full mode.",
  "vector": "invalid",
  "vector_error": "Could not open vrl program",
  "config": {
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "transforms": {
      "r": {
        "type": "remap",
        "inputs": [
          "in"
        ],
        "file": "/etc/vector/program.vrl"
      }
    },
    "sinks": {
      "out": {
        "type": "blackhole",
        "inputs": [
          "r"
        ]
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [
      {
        "code": "UNSUPPORTED_LOCAL_CAPABILITY",
        "at": "/transforms/r/file"
      }
    ],
    "components": [],
    "capabilities": [],
    "network": [],
    "listeners": [],
    "file_roots": [],
    "writes": [],
    "assets": []
  }
}
