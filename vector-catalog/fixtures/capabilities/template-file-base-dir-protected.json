{
  "description": "A base_dir inside the agent's state directory can't be approved.",
  "host": {
    "state_dir": "/var/lib/vectory-agent",
    "managed_config_dir": "/etc/vectory/managed"
  },
  "vector": "valid",
  "config": {
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "sinks": {
      "out": {
        "type": "file",
        "inputs": [
          "in"
        ],
        "encoding": {
          "codec": "json"
        },
        "base_dir": "/var/lib/vectory-agent/out",
        "path": "{{ host }}.log"
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [
      {
        "code": "FILE_ACCESS_DENIED",
        "at": "/sinks/out/base_dir"
      }
    ],
    "components": [],
    "capabilities": [],
    "network": [],
    "listeners": [],
    "file_roots": [],
    "writes": [],
    "assets": []
  }
}
