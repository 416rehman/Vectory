        "bucket": "logs",
        "region": "us-east-1",
        "encoding": {
          "codec": "json"
        },
        "auth": {
          "imds": {
            "max_attempts": 2
          }
        }
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [],
    "components": [
      "aws_s3"
    ],
    "capabilities": [
      "instance-credentials"
    ],
    "network": [],
    "listeners": [],
    "file_roots": [],
    "writes": [],
    "assets": []
  }
}
