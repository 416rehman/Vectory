{
  "description": "Tuning the instance metadata client is ambient.",
  "vector": "valid",
  "config": {
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "sinks": {
      "out": {
        "type": "aws_s3",
