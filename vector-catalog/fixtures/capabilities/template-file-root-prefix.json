{
  "description": "A templated path whose literal prefix is / has no root to approve; Vector refuses it too.",
  "vector": "invalid",
  "vector_error": "filesystem root",
  "config": {
    "sources": {
      "in": {
        "type": "demo_logs",
        "format": "json",
        "count": 1
      }
    },
    "sinks": {
      "out": {
        "type": "file",
        "inputs": [
          "in"
        ],
        "encoding": {
          "codec": "json"
        },
        "path": "/{{ host }}.log"
      }
    }
  },
  "needs": {
    "refused": [],
    "full_mode": [
      {
        "code": "TEMPLATE_RESOURCE_DENIED",
        "at": "/sinks/out/path"
      }
    ],
    "components": [],
    "capabilities": [],
    "network": [],
    "listeners": [],
    "file_roots": [],
    "writes": [],
    "assets": []
  }
}
