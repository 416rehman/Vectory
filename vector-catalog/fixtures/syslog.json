{
  "sources": {
    "sample": {
      "type": "syslog",
      "address": "127.0.0.1:5140",
      "mode": "tcp"
    }
  },
  "transforms": {
    "enrich": {
      "type": "remap",
      "inputs": [
        "sample"
      ],
      "source": ".environment = \"development\"\n.managed_by = \"vectory\""
    }
  },
  "sinks": {
    "output": {
      "type": "console",
      "inputs": [
        "enrich"
      ],
      "encoding": {
        "codec": "json"
      },
      "target": "stderr"
    }
  }
}
