{
  admin off
  auto_https off
}
https://{$VECTORY_HOSTNAME}:8443 {
  tls /run/secrets/server_cert /run/secrets/server_key {
    protocols tls1.3
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  @agent path /agent/*
  respond @agent 404
  reverse_proxy server:8080 {
    # The server trusts the last X-Forwarded-For hop (VECTORY_TRUST_PROXY_HEADERS);
    # replace any client-supplied value with the address Caddy sees.
    header_up X-Forwarded-For {remote_host}
    header_up -X-Client-Cert
    header_up -X-SSL-Client-Cert
    header_up -X-Forwarded-Client-Cert
  }
}
