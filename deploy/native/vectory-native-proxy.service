[Unit]
Description=Vectory browser HTTPS
Requires=vectory-native-server.service
After=network-online.target vectory-native-server.service
Wants=network-online.target

[Service]
Type=exec
User=vectory-proxy
Group=vectory-proxy
ExecStart=@KIT_ROOT@/bin/caddy run --config /etc/vectory-server/Caddyfile --adapter caddyfile
Environment=XDG_DATA_HOME=/var/lib/vectory-server/caddy-data
Environment=XDG_CONFIG_HOME=/var/lib/vectory-server/caddy-config
WorkingDirectory=/var/lib/vectory-server/caddy-data
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/vectory-server/caddy-data /var/lib/vectory-server/caddy-config
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077
MemoryMax=256M
TasksMax=64
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
